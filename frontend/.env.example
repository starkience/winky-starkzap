# ── App URL ──────────────────────────────────────────────────────────
# Production URL for OAuth callbacks and redirects
# Set this to your Vercel deployment URL (e.g. https://your-app.vercel.app)
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is auto-set as fallback
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Privy ────────────────────────────────────────────────────────────
# Client-side Privy App ID (from console.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Server-side Privy credentials (for wallet creation/signing API routes)
PRIVY_APP_ID=your_app_id
PRIVY_APP_SECRET=your_app_secret

# Privy authorization private key for server-side wallet signing
# Generate at console.privy.io > Wallets > Authorization Keys
# Base64-encoded PKCS8 private key (no PEM headers)
PRIVY_AUTHORIZATION_PRIVATE_KEY=your_authorization_private_key

# ── Starknet / Contract ─────────────────────────────────────────────
# Network: mainnet | sepolia
NEXT_PUBLIC_NETWORK=mainnet

# Winky contract address (optional, defaults based on network)
# NEXT_PUBLIC_WINKY_CONTRACT_ADDRESS=0x004918f613695bbd6ad40b853564b1fc6ab7e1630ecbc2c7db7705cdb937983f

# ── AVNU Paymaster ───────────────────────────────────────────────────
PAYMASTER_URL=https://starknet.paymaster.avnu.fi
PAYMASTER_API_KEY=your_paymaster_api_key

# ── Twitter OAuth 2.0 ───────────────────────────────────────────────
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# ── Escrow Owner (for duel resolution — server-side only) ────────────
ESCROW_OWNER_ADDRESS=0x...
ESCROW_OWNER_PRIVATE_KEY=0x...

# ── Vercel Edge Config (for Twitter profile storage) ─────────────────
EDGE_CONFIG_ID=your_edge_config_id
VERCEL_API_TOKEN=your_vercel_api_token
# VERCEL_TEAM_ID=your_team_id  # Only needed for team accounts

# ── Pusher (for live feed) ───────────────────────────────────────────
# PUSHER_APP_ID=...
# PUSHER_KEY=...
# PUSHER_SECRET=...
# NEXT_PUBLIC_PUSHER_KEY=...
# NEXT_PUBLIC_PUSHER_CLUSTER=...
